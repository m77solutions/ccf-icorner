{
  "trailingSlash": "always",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_next/*", "/images/*", "/events/*", "*.css", "*.js", "*.ico", "*.png", "*.jpg", "*.svg", "*.ics"]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".ics": "text/calendar"
  },
  "routes": [
    {
      "route": "/_next/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/events/*",
      "headers": {
        "content-type": "text/calendar; charset=utf-8",
        "content-disposition": "inline"
      }
    }
  ]
}
